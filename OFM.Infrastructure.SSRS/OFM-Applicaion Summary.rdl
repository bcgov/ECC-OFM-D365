          <Textbox Name="Textbox467">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Declaration</Value>
                    <Style>
                      <FontStyle>Italic</FontStyle>
                      <FontFamily>Verdana</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>DarkBlue</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>Textbox461</rd:DefaultName>
            <Top>34.49416in</Top>
            <Left>0.13333in</Left>
            <Height>0.31667in</Height>
            <Width>1.4248in</Width>
            <ZIndex>16</ZIndex>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
              <PaddingLeft>2pt</PaddingLeft>
              <PaddingRight>2pt</PaddingRight>
              <PaddingTop>2pt</PaddingTop>
              <PaddingBottom>2pt</PaddingBottom>
            </Style>
          </Textbox>
          <Textbox Name="Textbox469">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>I hereby confirm that the information I have provided in this application is complete and accurate. I certify that I have read and understand the following requirements:</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Verdana</FontFamily>
                      <FontSize>8pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>DimGray</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value />
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Verdana</FontFamily>
                      <FontSize>8pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>DimGray</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>             ·     Each facility must be licensed under the Community Care and Assisted Living Act;</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Verdana</FontFamily>
                      <FontSize>8pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>DimGray</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <HangingIndent>-0.25in</HangingIndent>
                <Style>
                  <TextAlign>Left</TextAlign>
                  <LineHeight>12pt</LineHeight>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>             ·     Each facility must be in compliance with the Community Care and Assisted Living Act and Child Care Licensing Regulation;</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Verdana</FontFamily>
                      <FontSize>8pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>DimGray</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <HangingIndent>-0.25in</HangingIndent>
                <Style>
                  <TextAlign>Left</TextAlign>
                  <LineHeight>12pt</LineHeight>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>·     Each facility must be willing to provide services to families who receive the Affordable Child Care Benefit;</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Verdana</FontFamily>
                      <FontSize>8pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>DimGray</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <LeftIndent>0.5in</LeftIndent>
                <HangingIndent>-0.25in</HangingIndent>
                <Style>
                  <TextAlign>Left</TextAlign>
                  <LineHeight>12pt</LineHeight>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>             ·     The organization must be in good standing with BC Corporate Registry (if a non-profit society or a registered company); and</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Verdana</FontFamily>
                      <FontSize>8pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>DimGray</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <HangingIndent>-0.25in</HangingIndent>
                <Style>
                  <TextAlign>Left</TextAlign>
                  <LineHeight>12pt</LineHeight>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>·     The applicant must be in good standing with the Ministry of Education and Child Care (that is, the Applicant must either have no outstanding balances owing to the Ministry OR the Applicant must have established payment plans for outstanding balances and these must be in good standing).</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Verdana</FontFamily>
                      <FontSize>8pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>DimGray</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <LeftIndent>0.5in</LeftIndent>
                <HangingIndent>-0.25in</HangingIndent>
                <Style>
                  <TextAlign>Left</TextAlign>
                  <LineHeight>12pt</LineHeight>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value />
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Verdana</FontFamily>
                      <FontSize>8pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>DimGray</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <LeftIndent>0.5in</LeftIndent>
                <HangingIndent>-0.25in</HangingIndent>
                <Style>
                  <TextAlign>Left</TextAlign>
                  <LineHeight>12pt</LineHeight>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Intentionally supplying information that is false or misleading with respect to a material fact in order to obtain a child care grant may lead to action being taken under Section 9 of the Child Care BC Act. If you are convicted of an offence under section 9, a court may order you imprison for up to six months, fine you not more than $2,000.00, or order you to pay the government all or part of any amount received under the child care grant.</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Verdana</FontFamily>
                      <FontSize>8pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>DimGray</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Left</TextAlign>
                  <LineHeight>12pt</LineHeight>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value />
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Verdana</FontFamily>
                      <FontSize>8pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>DimGray</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Left</TextAlign>
                  <LineHeight>12pt</LineHeight>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>I consent to the Ministry contacting other branches within the Ministry and other Province ministries to validate the accuracy of any information that I have provided.</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Verdana</FontFamily>
                      <FontSize>8pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>DimGray</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Left</TextAlign>
                  <LineHeight>12pt</LineHeight>
                </Style>
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>Textbox461</rd:DefaultName>

&lt;filter&gt;
&lt;condition attribute="statuscode" operator="eq" value="1" /&gt;
&lt;/filter&gt;
       &lt;link-entity name="ofm_licence" from="ofm_licenceid" to="ofm_licence" link-type="inner" alias="aa"&gt;

        <CommandText>&lt;fetch version="1.0" output-format="xml-platform" mapping="logical" distinct="false"&gt;
  &lt;entity name="ofm_licence_detail" &gt;
 &lt;attribute name="ofm_week_days_text" /&gt;
    &lt;attribute name="ofm_operations_to_time" /&gt;
